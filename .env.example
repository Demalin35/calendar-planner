NODE_ENV=production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WORK_DAY_START=09:00
WORK_DAY_END=18:00

# Reminders / Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Persistent SQLite path for reminders (required on Hostinger — use a path outside deploy dir)
# REMINDERS_DB_PATH=/path/to/persistent/reminders.db

# Optional local overrides only (Hostinger sets PORT automatically):
# PORT=3001

# Optional frontend override for split deployments (not needed on Hostinger):
# VITE_ASSISTANT_API_BASE_URL=
